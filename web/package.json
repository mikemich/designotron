{
  "name": "designotron-web",
  "version": "0.1.0",
  "description": "Designotron editor (web shell over the Rust/WASM engine)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "wasm": "cd .. && cargo build -p designotron-engine-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir web/src/wasm/pkg target/wasm32-unknown-unknown/release/designotron_engine_wasm.wasm",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "e2e": "node scripts/e2e.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  },
  "private": true
}
